{
  "name": "kontur_daily_digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * *"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Every Day 08:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KONTUR_API_URL + '/api/v1/digests/daily' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Kontur-Producer",
              "value": "n8n"
            },
            {
              "name": "X-Kontur-API-Key",
              "value": "={{ $env.KONTUR_N8N_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "digest",
      "name": "Create Kontur Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        0
      ]
    }
  ],
  "connections": {
    "Every Day 08:30": {
      "main": [
        [
          {
            "node": "Create Kontur Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Moscow"
  },
  "versionId": "kontur-daily-digest-v1",
